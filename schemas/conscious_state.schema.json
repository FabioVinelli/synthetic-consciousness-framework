{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCF Minimum Conscious Harness state v0.1",
  "description": "Proposed provider-neutral snapshot. Epistemic records are operational claims, not subjective experience. Validate with format checking enabled. Reference integrity, evidence semantics, authority, history and control limits require runtime checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state_revision",
    "previous_state_reference",
    "continuity_scope",
    "updated_at",
    "phase",
    "status",
    "objective",
    "constraints",
    "self_model",
    "world_model",
    "active_intentions",
    "attention",
    "beliefs",
    "uncertainties",
    "assumptions",
    "capabilities",
    "limitations",
    "unresolved_questions",
    "recent_actions",
    "predicted_consequences",
    "observed_consequences",
    "model_revisions",
    "memory_references",
    "values_check",
    "reflection",
    "control"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "previous_state_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "continuity_scope": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "enum": [
        "INPUT",
        "CONTEXT",
        "MEMORY",
        "WORLD MODEL",
        "SELF MODEL",
        "ATTENTION",
        "INTERPRETATIONS",
        "EPISTEMIC CHECK",
        "INTENTION",
        "VALUES CHECK",
        "CONSEQUENCE MODEL",
        "ACTION",
        "OBSERVATION",
        "REFLECTION",
        "STATE/MEMORY UPDATE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "running",
        "completed",
        "abstained",
        "escalated",
        "stopped",
        "failed"
      ]
    },
    "objective": {
      "$ref": "#/$defs/record"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "self_model": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "description": "Scoped claims about the system; persist using versioned memory. Empty means no self-model records supplied."
    },
    "world_model": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "description": "Scoped claims about external conditions; separate from claims about the system."
    },
    "active_intentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intention"
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attention"
      }
    },
    "beliefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "recent_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "predicted_consequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prediction"
      }
    },
    "observed_consequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "model_revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "memory_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory"
      },
      "description": "Pointers only. Epistemic content lives in referenced records retaining original classification and support metadata."
    },
    "values_check": {
      "$ref": "#/$defs/values"
    },
    "reflection": {
      "$ref": "#/$defs/reflection"
    },
    "control": {
