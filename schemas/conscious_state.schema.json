  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_reference",
        "locator",
        "origin",
        "source_information_class",
        "captured_at",
        "transformation"
      ],
      "properties": {
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "input",
            "tool",
            "environment",
            "memory",
            "model",
            "trusted_configuration",
            "human"
          ]
        },
        "source_information_class": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "observed",
                "reported",
                "remembered",
                "inferred",
                "hypothesized",
                "imagined",
                "intended",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "transformation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "information_class",
        "provenance",
        "confidence",
        "evidence_status",
        "evidence_references",
        "counterevidence_references",
        "revision_conditions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "information_class": {
